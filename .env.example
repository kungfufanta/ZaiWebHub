# ZaiWebHub — env mẫu. Copy thành .env của service tương ứng (KHÔNG commit giá trị thật).

# ----- mini-services/hub (:3003) -----
PORT=3003
# Bearer keys cho /v1/* — phân tách bằng dấu phẩy. Dev default: zhb_dev_default_key (public-by-design cho sandbox MVP).
TENANT_KEYS=zhb_dev_default_key
# HMAC signing secret cho worker token (mint/verify). Sinh: openssl rand -hex 24
WEBHUB_SECRET=dev-secret-rotate-me
# Gate /internal/worker-token — worker phải gửi header X-Worker-Secret khớp giá trị này.
# KHÔNG set → dev loopback-only, CẤM expose công khai. Sinh: openssl rand -hex 24
WORKER_SECRET=

# ----- mini-services/worker (:3005) -----
WORKER_PORT=3005
# Boot bằng env (ưu tiên cao hơn file config UI): đủ 3 biến dưới → runtime tự start lúc boot.
# HUB_URL=https://<hub-host>/?XTransformPort=3003
# WORKER_ID=w1-<hostname>
# WORKER_SECRET=

# ----- main app console (:3000) -----
# Hub nội bộ cho proxy /api/workers (giữ secret server-side). Default đã đúng cho 1 sandbox.
# HUB_INTERNAL_URL=http://127.0.0.1:3003
# WORKER_SECRET= (cùng giá trị với hub — để tab Workers hiển thị Connection Info)
