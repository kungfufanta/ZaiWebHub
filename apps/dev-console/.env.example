# apps/dev-console — UI test 3 mode (Mock / Adapter / WebHub).
# Muốn UI public cho owner dùng → chạy trên :3000 của sandbox (UI asset chỉ load chuẩn qua cổng public).

# Đợt 3.5 — console ở sandbox KHÁC hub: set CẢ HAI env dưới (cùng origin gateway của hub)
# rồi RESTART console (NEXT_PUBLIC_* inline lúc dev-boot, không hot-reload).
#   NEXT_PUBLIC_WEBHUB_URL → client fetch absolute: https://<hub-host>/v1/chat/completions?XTransformPort=3003
#   WEBHUB_ORIGIN          → rewrite server-side fallback (dùng gateway hub, auto thêm XTransformPort)
NEXT_PUBLIC_WEBHUB_URL=https://<hub-host>
WEBHUB_ORIGIN=https://<hub-host>

# Không set → hub cùng sandbox (mặc định: relative /v1/... + rewrite localhost:3003).

# Đợt 3.6-H — Hub UI (tab /workers + /stats): server-side proxy /api/workers → webhub
#   GET {HUB_INTERNAL_URL}/internal/workers với header X-Worker-Secret.
#   HUB_INTERNAL_URL : mặc định http://127.0.0.1:3003 (console cùng sandbox hub) — đổi nếu khác.
#   WORKER_SECRET    : GIÁ TRỊ THẬT đặt vào .env.local (KHÔNG commit) — phải khớp env WORKER_SECRET
#                      của webhub :3003. Secret chỉ nằm ở server, client chỉ thấy /api/workers.
HUB_INTERNAL_URL=http://127.0.0.1:3003
# WORKER_SECRET=<giá trị thật — đặt trong .env.local, không commit>

# Chạy: cd apps/dev-console && node node_modules/.bin/next dev -p 3000
# (trước đó phải build compat bundle: node ./scripts/build-compat.ts hoặc bun run build:compat)
