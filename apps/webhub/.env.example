# apps/webhub — hub (control plane). Copy sang .env hoặc export trực tiếp khi chạy.
# Hub KHÔNG giữ ZAI_API_KEY, KHÔNG gọi upstream — chỉ registry + dispatch + relay bytes.

PORT=3003

# Bearer keys cho /v1/* (phân tách bằng dấu phẩy).
# Dev default: zhb_dev_default_key — public-by-design cho sandbox MVP (T3-e), KHÔNG phải secret.
TENANT_KEYS=zhb_dev_default_key

# HMAC signing secret cho worker token (mint/verify). Nên set để khỏi dùng default dev.
WEBHUB_SECRET=<openssl rand -hex 24>

# Đợt 3.5 — gate /internal/worker-token: worker phải gửi header X-Worker-Secret khớp giá trị này.
# KHÔNG set → dev loopback-only, CẤM expose công khai (ai cũng mint token được).
WORKER_SECRET=<openssl rand -hex 24>
