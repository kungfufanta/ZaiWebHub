# apps/worker — executor (data plane). Worker CHỈ cần outbound tới hub (WS + HTTPS fetch token).
# Chạy: cd apps/worker && node node_modules/.bin/next dev -p 3004  (env export trước khi boot).

# WS endpoint của hub:
#   loopback dev : ws://localhost:3003/worker
#   remote       : wss://<hub-host>/worker?XTransformPort=3003   (qua gateway hub, TLS do gateway lo)
HUB_URL=wss://<hub-host>/worker?XTransformPort=3003

# Token endpoint — khi qua gateway hub, URL PHẢI kèm ?XTransformPort=3003 (worker tự nối &tenant_id=...).
HUB_TOKEN_URL=https://<hub-host>/internal/worker-token?XTransformPort=3003
# (HUB_HTTP_BASE chỉ dùng khi KHÔNG set HUB_TOKEN_URL — mặc định http://localhost:3003)

# Shared secret, KHỚP env WORKER_SECRET của hub. BẮT BUỘC khi hub expose công khai —
# sai/thiếu → hub trả 401 → worker log "worker-token endpoint HTTP 401" lặp lại.
WORKER_SECRET=<same-as-hub>

WORKER_ID=w1-<ten-sandbox>
WORKER_CONCURRENCY=2
TENANT_ID=default

# F8: proxy = key sandbox nội bộ (mặc định, mỗi sandbox có /etc/.z-ai-config sẵn);
#     real  = key Z.AI thật cho production (chưa có — mọi kết quả vẫn nhãn mock-verified).
UPSTREAM=proxy

# relay = không gọi zsdk, chỉ relay frame (T4-d, tương lai)
MODE=worker
